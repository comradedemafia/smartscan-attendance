# Frontend (Vite) — copy to .env and fill in your project values.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# The following are NOT read by the Vite app. Configure them as edge function
# secrets instead (e.g. `supabase secrets set ALLOWED_ORIGINS=...`):
#
# ALLOWED_ORIGINS        Comma-separated list of trusted browser origins,
#                        e.g. "https://app.example.com,http://localhost:5173".
#                        When unset, only the production worker and localhost
#                        dev origins are allowed; there is no "*" fallback.
# CRON_SECRET            Shared secret required by the optional-deadline-reminders
#                        scheduled job (send via `x-cron-secret` header).
# TOTP_ISSUER            Label shown in authenticator apps (default:
#                        "SmartScan Attendance").
#
# Supabase also injects SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY into edge functions automatically.
#
# GitHub Actions (repository secrets):
# VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY  keep-alive workflow
# SUPABASE_DB_URL                                    pooler connection string
#                                                    for the weekly backup workflow
# CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID       deploy-cloudflare workflow
